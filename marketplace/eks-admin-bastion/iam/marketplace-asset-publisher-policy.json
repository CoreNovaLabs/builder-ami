{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAssetBucketControls",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:GetBucketVersioning", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::corenova-marketplace-assets-582920575154",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["eks-admin-bastion", "eks-admin-bastion/*"]
        }
      }
    },
    {
      "Sid": "PublishVersionedEksAssets",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject", "s3:PutObjectTagging"],
      "Resource": "arn:aws:s3:::corenova-marketplace-assets-582920575154/eks-admin-bastion/*"
    },
    {
      "Sid": "DenyAssetDeletion",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::corenova-marketplace-assets-582920575154/*"
    },
    {
      "Sid": "DenyBucketMutation",
      "Effect": "Deny",
      "Action": ["s3:DeleteBucket", "s3:PutBucketPolicy", "s3:PutBucketPublicAccessBlock", "s3:PutBucketVersioning"],
      "Resource": "arn:aws:s3:::corenova-marketplace-assets-582920575154"
    }
  ]
}
