{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCandidateImages",
      "Effect": "Allow",
      "Action": "ec2:DescribeImages",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "CatalogList",
      "Effect": "Allow",
      "Action": [
        "aws-marketplace:ListEntities",
        "aws-marketplace:ListChangeSets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DescribeSellerAmiProducts",
      "Effect": "Allow",
      "Action": "aws-marketplace:DescribeEntity",
      "Resource": [
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-hapxotc2y7jmi",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-nspz2g6ki6qvo",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-nptqkfuwrh5ik",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-ereepz5xafyw2",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-uca3f3ujrl5gg",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-fkmhgwyoiz5ls",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-hv5ebdtqf2too",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-xn4vfcpfcxqoq",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-4tnfzjf4ynkgw",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-7cvvy2gp6ryoc",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-j4fhcdjn5o46o",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-lyolayhuy6hi2",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-xcp3pur5ik4ti",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-hqk6nphpcucgk",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-jxjqud52zrofw",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-fltwx2ns5fmss",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-sigm7ovzlqdte"
      ]
    },
    {
      "Sid": "DescribeChangeSets",
      "Effect": "Allow",
      "Action": "aws-marketplace:DescribeChangeSet",
      "Resource": "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/ChangeSet/*"
    },
    {
      "Sid": "ValidateNewVersionsForSellerAmiProducts",
      "Effect": "Allow",
      "Action": "aws-marketplace:StartChangeSet",
      "Resource": [
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-hapxotc2y7jmi",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-nspz2g6ki6qvo",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-nptqkfuwrh5ik",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-ereepz5xafyw2",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-uca3f3ujrl5gg",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-fkmhgwyoiz5ls",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-hv5ebdtqf2too",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-xn4vfcpfcxqoq",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-4tnfzjf4ynkgw",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-7cvvy2gp6ryoc",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-j4fhcdjn5o46o",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-lyolayhuy6hi2",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-xcp3pur5ik4ti",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-hqk6nphpcucgk",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-jxjqud52zrofw",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-fltwx2ns5fmss",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-sigm7ovzlqdte",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/ChangeSet/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws-marketplace:Intent": "VALIDATE",
          "catalog:ChangeType": "AddDeliveryOptions"
        }
      }
    },
    {
      "Sid": "DenyApplyIncludingImplicitDefault",
      "Effect": "Deny",
      "Action": "aws-marketplace:StartChangeSet",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws-marketplace:Intent": "VALIDATE"
        }
      }
    },
    {
      "Sid": "DenyNonVersionValidationChanges",
      "Effect": "Deny",
      "Action": "aws-marketplace:StartChangeSet",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "catalog:ChangeType": "AddDeliveryOptions"
        }
      }
    },
    {
      "Sid": "ReadIngestionRole",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::582920575154:role/CoreNovaMarketplaceAmiIngestion"
    },
    {
      "Sid": "PassOnlyIngestionRoleToMarketplaceAssets",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::582920575154:role/CoreNovaMarketplaceAmiIngestion",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "assets.marketplace.amazonaws.com"
        }
      }
    }
  ]
}
