{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CatalogList",
      "Effect": "Allow",
      "Action": [
        "aws-marketplace:ListEntities",
        "aws-marketplace:ListChangeSets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DescribeExactEksProductsAndOffers",
      "Effect": "Allow",
      "Action": "aws-marketplace:DescribeEntity",
      "Resource": [
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-hapxotc2y7jmi",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-nspz2g6ki6qvo",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/Offer/offer-2izpqagw3tftq",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/Offer/offer-2n3inrntp75ye"
      ]
    },
    {
      "Sid": "DescribeChangeSets",
      "Effect": "Allow",
      "Action": "aws-marketplace:DescribeChangeSet",
      "Resource": "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/ChangeSet/*"
    },
    {
      "Sid": "ApplyExactInstanceExpansion",
      "Effect": "Allow",
      "Action": "aws-marketplace:StartChangeSet",
      "Resource": [
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-hapxotc2y7jmi",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/AmiProduct/prod-nspz2g6ki6qvo",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/Offer/offer-2izpqagw3tftq",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/Offer/offer-2n3inrntp75ye",
        "arn:aws:aws-marketplace:us-east-1:582920575154:AWSMarketplace/ChangeSet/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws-marketplace:Intent": "APPLY",
          "catalog:ChangeType": [
            "AddInstanceTypes",
            "AddDimensions",
            "UpdatePricingTerms"
          ]
        }
      }
    },
    {
      "Sid": "DenyNonApplyIntent",
      "Effect": "Deny",
      "Action": "aws-marketplace:StartChangeSet",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws-marketplace:Intent": "APPLY"
        }
      }
    },
    {
      "Sid": "DenyOtherChangeTypes",
      "Effect": "Deny",
      "Action": "aws-marketplace:StartChangeSet",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "catalog:ChangeType": [
            "AddInstanceTypes",
            "AddDimensions",
            "UpdatePricingTerms"
          ]
        }
      }
    }
  ]
}
